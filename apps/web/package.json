{
  "name": "@chess-coach/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-pwa.mjs",
    "build:pages": "tsc -b && vite build --base=/chess-coach/ --outDir=dist-pages && node scripts/generate-pwa.mjs --dist=dist-pages --base=/chess-coach/ --pages",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src --passWithNoTests && node --test scripts/generate-pwa.test.mjs"
  },
  "dependencies": {
    "@chess-coach/chess-core": "workspace:*",
    "@chess-coach/coach": "workspace:*",
    "@chess-coach/engine": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "^29.1.1",
    "vite": "8.1.5"
  }
}
