{
  "name": "chess-coach",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Pablo Beas",
    "email": "pbeasboc@gmail.com",
    "url": "https://www.linkedin.com/in/pablo-beas-bocanegra-05882a200/"
  },
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Pablobeas/chess-coach",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pablobeas/chess-coach.git"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node tools/dev-with-maia.mjs",
    "dev:web": "pnpm --filter @chess-coach/web dev",
    "build": "pnpm -r --if-present build",
    "build:sites": "node tools/build-sites.mjs",
    "build:pages": "pnpm --filter @chess-coach/web build:pages",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:tools && pnpm test:evals && pnpm -r --if-present test",
    "test:evals": "vitest run --config tests/evals/vitest.config.ts",
    "test:tools": "node --test tools/*.test.mjs",
    "verify:training-content": "node tools/training/verify-puzzles-v1.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "codex:doctor": "codex doctor"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "chess.js": "1.4.0",
    "prettier": "3.9.5",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
